<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the LupiraGeoApi.* namespaces unchanged across the project split. -->
    <RootNamespace>LupiraGeoApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal helpers (geo math, resolver, importer parsing) for unit testing. -->
    <InternalsVisibleTo Include="LupiraGeoApi.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Two storage models, one database (same pattern as LupiraCommsApi): Marten plain documents on the
         `geo_user` schema (principal + saved places + geocode cache), and EF Core + PostGIS/NetTopologySuite
         on the `geo` schema (the gazetteer + admin reference data, with real geography columns + GiST). The
         schemas are disjoint so Marten's schema-diff never touches the EF tables. No ASP.NET here. -->
    <PackageReference Include="Marten" Version="9.10.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.0" />
  </ItemGroup>

</Project>
